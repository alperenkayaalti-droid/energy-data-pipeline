# Energy Data Analysis Notebook
# Banvit Energy Efficiency Project - Python Pipeline Example

import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns

print("✅ Kütüphaneler yüklendi!")
# Örnek enerji tüketim verisi oluşturalım (gerçek veriye benzer)
np.random.seed(42)

dates = pd.date_range(start='2022-01-01', periods=365, freq='D')

data = {
    'date': dates,
    'steam_consumption': np.random.normal(4500, 800, 365),
    'compressed_air': np.random.normal(1200, 250, 365),
    'water_usage': np.random.normal(850, 150, 365),
    'production_volume': np.random.normal(12500, 2000, 365)
}

df = pd.DataFrame(data)

# Bazı gerçekçi hatalar ekleyelim (temizleme pratiği için)
df.loc[50:55, 'steam_consumption'] = np.nan          # missing values
df.loc[100, 'compressed_air'] = -150                 # outlier

print("Veri seti oluşturuldu. İlk 5 satır:")
display(df.head())
# Veri Temizleme ve Validasyon
print("Orijinal veri boyutu:", df.shape)

# Missing values doldurma
df['steam_consumption'] = df['steam_consumption'].fillna(df['steam_consumption'].median())

# Negatif değerleri düzeltme
df['compressed_air'] = df['compressed_air'].clip(lower=0)

# Yeni KPI'lar hesaplama
df['total_energy'] = df['steam_consumption'] + df['compressed_air']
df['energy_per_unit'] = df['total_energy'] / df['production_volume']

print("Temizleme sonrası veri boyutu:", df.shape)
print("\nTemel İstatistikler:")
display(df.describe())
# Görselleştirme
plt.figure(figsize=(12, 6))

plt.subplot(2, 1, 1)
plt.plot(df['date'], df['total_energy'], label='Total Energy', color='blue')
plt.title('Daily Total Energy Consumption')
plt.xlabel('Date')
plt.ylabel('Energy (unit)')
plt.legend()

plt.subplot(2, 1, 2)
plt.plot(df['date'], df['energy_per_unit'], label='Energy per Production Unit', color='green')
plt.title('Energy Efficiency (per unit)')
plt.xlabel('Date')
plt.ylabel('Energy / Production')
plt.legend()

plt.tight_layout()
plt.show()
# Basit Hareketli Ortalama ile Forecasting
df['ma_30'] = df['total_energy'].rolling(window=30).mean()

plt.figure(figsize=(10, 5))
plt.plot(df['date'], df['total_energy'], label='Actual', alpha=0.7)
plt.plot(df['date'], df['ma_30'], label='30-day Moving Average (Forecast)', color='red', linewidth=2)
plt.title('Energy Consumption Forecast using Moving Average')
plt.xlabel('Date')
plt.ylabel('Energy')
plt.legend()
plt.show()

print("✅ Basit forecasting tamamlandı!")
