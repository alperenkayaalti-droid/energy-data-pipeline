import os
import numpy as np
import pandas as pd


def load_raw_data(filepath):
    """Simulate data ingestion from SCADA / Excel logs."""
    if not os.path.exists(filepath):
        # Create dummy dataframe if file doesn't exist for demo purposes
        print(f"File {filepath} not found. Generating synthetic energy data...")
        dates = pd.date_range(start="2026-01-01", end="2026-05-31", freq="H")
        np.random.seed(42)
        df = pd.DataFrame(
            {
                "timestamp": dates,
                "steam_consumption_m3": np.random.normal(loc=150, scale=25, size=len(dates)),
                "compressed_air_m3": np.random.normal(loc=500, scale=80, size=len(dates)),
                "electricity_kwh": np.random.normal(loc=1200, scale=150, size=len(dates)),
            }
        )
        # Introduce some anomalies/nulls on purpose to show how we clean them
        df.loc[10:12, "electricity_kwh"] = np.nan
        df.loc[100, "steam_consumption_m3"] = -999  # SCADA sensor error
        return df
    return pd.read_csv(filepath, parse_dates=["timestamp"])


def validate_and_clean_data(df):
    """Enforce data quality rules (Critical for Ember's standards)."""
    cleaned_df = df.copy()

    # Rule 1: Drop rows where critical timestamp is missing
    cleaned_df = cleaned_df.dropna(subset=["timestamp"])

    # Rule 2: Handle sensor anomalies (negative energy consumption is impossible)
    energy_cols = ["steam_consumption_m3", "compressed_air_m3", "electricity_kwh"]
    for col in energy_cols:
        # Replace negative values with NaN
        cleaned_df.loc[cleaned_df[col] < 0, col] = np.nan

    # Rule 3: Impute missing values using forward fill (or rolling mean)
    cleaned_df[energy_cols] = cleaned_df[energy_cols].ffill().bfill()

    print(f"Data validation complete. Cleaned rows: {len(cleaned_df)}")
    return cleaned_df


def calculate_energy_kpis(df):
    """Transform hourly operational data into daily KPIs."""
    df["date"] = df["timestamp"].dt.date
    daily_summary = (
        df.groupby("date")
        .agg(
            {
                "steam_consumption_m3": "sum",
                "compressed_air_m3": "sum",
                "electricity_kwh": "sum",
            }
        )
        .reset_index()
    )

    # Calculate a proxy baseline or rolling average for forecasting
    daily_summary["electricity_7d_moving_avg"] = (
        daily_summary["electricity_kwh"].rolling(window=7, min_periods=1).mean()
    )

    return daily_summary


if __name__ == "__main__":
    # Run the mini ETL pipeline
    raw_data = load_raw_data("data/raw_factory_logs.csv")
    cleaned_data = validate_and_clean_data(raw_data)
    daily_kpis = calculate_energy_kpis(cleaned_data)

    # Save output
    os.makedirs("data", exist_ok=True)
    daily_kpis.to_csv("data/daily_energy_kpis.csv", index=False)
    print("ETL Pipeline executed successfully. Daily KPIs saved to 'data/'")
